{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MPPI loop plumbing check (--quick)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_loop.py",
      "args": ["--weight", "1", "--seed", "1", "--quick", "--rounds", "2", "--workers", "2", "--out", "runs/quick_check"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "tests"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
